---
import AppLayout from "../layouts/AppLayout.astro";
import UsersIsland from "../components/islands/UsersIsland.jsx";

// Admin-only. The API enforces this too (require_admin on /api/users); this
// redirect just avoids rendering a page that would only 403.
if (Astro.locals.user?.role !== "admin") return Astro.redirect("/");
---

<AppLayout title="Users">
  <UsersIsland client:load />
</AppLayout>
