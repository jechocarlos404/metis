# Copy to .env and fill in what you use. Everything is optional —
# the app runs with zero LLM keys (chat will say no provider is configured).

# --- Auth (Keycloak / OIDC) ---
# AUTH_ENABLED=false treats every request as admin (local seed/curl escape hatch).
# Leave true for normal docker compose (Keycloak is included).
AUTH_ENABLED=true
KEYCLOAK_ISSUER=http://localhost:8080/realms/metis
KEYCLOAK_AUDIENCE=metis-backend
KEYCLOAK_ADMIN_CLIENT_ID=metis-backend
METIS_BACKEND_CLIENT_SECRET=dev-backend-secret
METIS_WEB_CLIENT_SECRET=dev-web-secret
# Seals the sign-in cookie. Sign-in refuses to start without one while auth is on.
# Make one: openssl rand -hex 32
SESSION_SECRET=
PUBLIC_APP_URL=http://localhost:4321

# --- MCP server (docker compose --profile mcp) ---
# The metis-mcp Keycloak client the MCP server signs in with; must match the realm.
METIS_MCP_CLIENT_SECRET=dev-mcp-secret
# Required for SSE mode (the compose mcp service); every request must send it as a
# bearer token. Make one: openssl rand -hex 32
METIS_MCP_SSE_TOKEN=

# --- LLM providers (set any subset; availability is auto-detected) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# AWS Bedrock (Claude models on Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Ollama (local models). From inside Docker, host Ollama is reachable at
# http://host.docker.internal:11434 (the compose default).
OLLAMA_BASE_URL=http://host.docker.internal:11434
