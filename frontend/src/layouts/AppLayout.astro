---
import HealthBadges from "../components/shell/HealthBadges.jsx";
import NavLink from "../components/shell/NavLink.astro";
import "../styles/global.css";

const NAV = [
  { href: "/chat", label: "Chat", icon: "message-square" },
  { href: "/goals", label: "Goals", icon: "target" },
  { href: "/capabilities", label: "Capabilities", icon: "layers" },
  { href: "/features", label: "Features", icon: "network" },
  { href: "/products", label: "Products", icon: "package" },
  // Buy plane. /capabilities/[slug] and /tech/[slug] are detail routes reached
  // by link, and exposure is a view of /tech — six routes, three nav items.
  { href: "/tech", label: "Tech", icon: "circuit-board" },
  { href: "/stacks", label: "Stacks", icon: "layers" },
  { href: "/users", label: "Users", icon: "users", admin: true },
  { href: "/admin", label: "LLM Config", icon: "settings", admin: true },
  // Help position: the document that teaches the vocabulary, last.
  { href: "/ontology", label: "Ontology", icon: "book-open", foot: true },
];

const { title = "Metis" } = Astro.props;
const user = Astro.locals.user;
const isAdmin = user?.role === "admin";
const visible = NAV.filter((item) => !item.admin || isAdmin);
const nav = visible.filter((item) => !item.foot);
const footNav = visible.filter((item) => item.foot);
const displayName = user?.name || user?.username || "";
const initials =
  displayName
    .split(/[\s@._-]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((s) => s[0].toUpperCase())
    .join("") || "?";
const path = Astro.url.pathname;
const isActive = (href) => path === href || path.startsWith(href + "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · metis</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div style="display:flex; height:100vh; background:var(--surface-page); overflow:hidden;">
      <aside
        style="width:216px; flex:none; border-right:1px solid var(--border-hairline); background:var(--surface-card); display:flex; flex-direction:column;"
      >
        <div style="padding:18px 20px 14px; display:flex; align-items:baseline; gap:8px;">
          <span
            style="font-family:var(--font-display); font-weight:var(--weight-semibold); font-size:20px; letter-spacing:var(--tracking-tight); color:var(--text-heading);"
            >metis</span
          >
          <span style="font-family:var(--font-mono); font-size:10px; color:var(--text-disabled);"
            >v0.1</span
          >
        </div>
        <nav style="display:flex; flex-direction:column; gap:2px; padding:0 10px;">
          {nav.map((item) => <NavLink {...item} active={isActive(item.href)} />)}
        </nav>
        <div style="margin-top:auto; display:flex; flex-direction:column;">
          {footNav.length > 0 && (
            <nav style="display:flex; flex-direction:column; gap:2px; padding:0 10px 10px;">
              {footNav.map((item) => <NavLink {...item} active={isActive(item.href)} />)}
            </nav>
          )}
          {
            user && (
              <div style="padding:12px 16px; border-top:1px solid var(--border-hairline); display:flex; align-items:center; gap:10px;">
                <div style="width:30px; height:30px; border-radius:50%; background:var(--accent-wash); color:var(--text-accent); display:flex; align-items:center; justify-content:center; font-family:var(--font-mono); font-size:12px; font-weight:600; flex:none;">
                  {initials}
                </div>
                <div style="min-width:0; flex:1;">
                  <div style="font-size:var(--text-sm); color:var(--text-heading); font-weight:var(--weight-medium); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                    {displayName}
                  </div>
                  <div style="font-family:var(--font-mono); font-size:10px; letter-spacing:var(--tracking-caps); text-transform:uppercase; color:var(--text-secondary);">
                    {user.role ?? "no role"}
                  </div>
                </div>
                <a
                  href="/auth/logout"
                  title="Log out"
                  style="display:flex; padding:6px; color:var(--text-disabled); border-radius:var(--radius-sm); text-decoration:none;"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <path d="m16 17 5-5-5-5" />
                    <path d="M21 12H9" />
                  </svg>
                </a>
              </div>
            )
          }
          <div style="padding:16px; border-top:1px solid var(--border-hairline); display:flex; flex-direction:column; gap:6px;">
            <div
              style="font-family:var(--font-mono); font-size:10px; letter-spacing:var(--tracking-caps); text-transform:uppercase; color:var(--text-disabled);"
            >
              Pipeline health
            </div>
            <HealthBadges client:idle />
          </div>
        </div>
      </aside>
      <main style="flex:1; min-width:0; display:flex; flex-direction:column; overflow:hidden;">
        <slot />
      </main>
    </div>
  </body>
</html>
