---
import AppLayout from "../../layouts/AppLayout.astro";
import CapabilityIsland from "../../components/islands/CapabilityIsland.jsx";

const { slug } = Astro.params;
const canWrite = ["editor", "admin"].includes(Astro.locals.user?.role);
---

<AppLayout title={`Capability · ${slug}`}>
  <CapabilityIsland client:load slug={slug} canWrite={canWrite} />
</AppLayout>
