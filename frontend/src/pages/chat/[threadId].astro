---
import AppLayout from "../../layouts/AppLayout.astro";
import ChatIsland from "../../components/islands/ChatIsland.jsx";

const { threadId } = Astro.params;
const canWrite = ["editor", "admin"].includes(Astro.locals.user?.role);
---

<AppLayout title="Chat">
  <ChatIsland client:load threadId={threadId} canWrite={canWrite} />
</AppLayout>
