---
import AppLayout from "../layouts/AppLayout.astro";
import DataIsland from "../components/islands/DataIsland.jsx";
import AdminOnly from "../components/shell/AdminOnly.astro";

// Admin-only. The API enforces it too (require_admin on /api/admin/data); anyone
// else gets a page that says why rather than an unexplained bounce.
const isAdmin = Astro.locals.user?.role === "admin";
if (!isAdmin) Astro.response.status = 403;
---

<AppLayout title="Raw data">
  {isAdmin ? <DataIsland client:load /> : <AdminOnly title="Raw data" />}
</AppLayout>
