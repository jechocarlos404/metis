---
import AppLayout from "../../layouts/AppLayout.astro";
import TechCatalogIsland from "../../components/islands/TechCatalogIsland.jsx";

// `?view=exposure` is a view of this route, not a second one — keeping it in
// the URL is what makes a resolved screen linkable.
const view = Astro.url.searchParams.get("view") === "exposure" ? "exposure" : "catalog";
const query = Astro.url.searchParams.get("q") ?? "";
const kind = Astro.url.searchParams.get("kind") ?? "";
const layer = Astro.url.searchParams.get("layer") ?? "";
const adoption = Astro.url.searchParams.get("adoption") ?? "";
---

<AppLayout title="Tech">
  <TechCatalogIsland client:load initialView={view} initialQuery={query} initialKind={kind} initialLayer={layer} initialAdoption={adoption} />
</AppLayout>
