---
import HealthBadges from "../components/shell/HealthBadges.jsx";
import NavLink from "../components/shell/NavLink.astro";
import { roleCan, roleLabel } from "../components/shell/roles.js";
import "../styles/global.css";

const { title = "Metis" } = Astro.props;
const user = Astro.locals.user;
const canWrite = ["editor", "admin"].includes(user?.role);

// Technology and Stacks stay out of the nav until they hold data. On any
// failure (timeout, 401, backend down) the item stays hidden.
const backend = (process.env.API_INTERNAL_URL || "http://localhost:8000").replace(/\/$/, "");
let presence = {};
try {
  const res = await fetch(`${backend}/api/tech/presence`, {
    headers: { authorization: `Bearer ${Astro.locals.accessToken}` },
    signal: AbortSignal.timeout(1500),
  });
  if (res.ok) presence = await res.json();
} catch {
  // stay hidden
}
const hasTech = presence?.technologies === true;
const hasStacks = presence?.stacks === true;

const path = Astro.url.pathname;
const under = (href) => path === href || path.startsWith(href + "/");

const top = [
  { href: "/home", label: "Home", icon: "house", active: path === "/" || under("/home") || under("/inventory") },
  { href: "/chat", label: "Chat", icon: "message-square" },
];
const groups = [
  {
    label: "Portfolio",
    items: [
      { href: "/products", label: "Products", icon: "package" },
      { href: "/journeys", label: "Ideas & journeys", icon: "git-branch" },
      { href: "/capabilities", label: "Capabilities", icon: "layers" },
      { href: "/goals", label: "Goals", icon: "target" },
    ],
  },
  {
    label: "Build & buy",
    // Closed by default; open when the current page is inside it, or once
    // technologies or stacks exist, so the item that arrives with them is
    // seen. The path check keeps a page under /tech open even if the presence
    // call failed.
    collapsible: true,
    open: hasTech || hasStacks || ["/features", "/tech", "/stacks"].some(under),
    items: [
      { href: "/features", label: "Features", icon: "network" },
      hasTech && { href: "/tech", label: "Technology", icon: "circuit-board" },
      hasStacks && { href: "/stacks", label: "Stacks", icon: "boxes" },
    ].filter(Boolean),
  },
];
const foot = [
  canWrite && {
    href: "/settings", label: "Settings", icon: "settings",
    active: ["/settings", "/users", "/admin", "/data"].some(under),
  },
  { href: "/guide", label: "Guide", icon: "book-open" },
].filter(Boolean);
const withActive = (item) => ({ ...item, active: item.active ?? under(item.href) });

const displayName = user?.name || user?.username || "";
const initials =
  displayName
    .split(/[\s@._-]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((s) => s[0].toUpperCase())
    .join("") || "?";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · metis</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div style="display:flex; height:100vh; background:var(--surface-page); overflow:hidden;">
      <aside
        class="app-sidebar"
        style="width:216px; flex:none; border-right:1px solid var(--border-hairline); background:var(--surface-card); display:flex; flex-direction:column;"
      >
        <div style="padding:18px 20px 14px; display:flex; align-items:baseline; gap:8px;">
          <span
            style="font-family:var(--font-display); font-weight:var(--weight-semibold); font-size:20px; letter-spacing:var(--tracking-tight); color:var(--text-heading);"
            >metis</span
          >
          <span class="rail-hide" style="font-family:var(--font-mono); font-size:var(--text-2xs); color:var(--text-secondary);"
            >v0.1</span
          >
        </div>
        <nav aria-label="Main" style="display:flex; flex-direction:column; gap:2px; padding:0 10px;">
          {top.map((item) => <NavLink {...withActive(item)} />)}
          {
            groups.map((group) => group.collapsible ? (
              <details class="nav-group" open={group.open} aria-label={group.label} style="margin-top:14px;">
                <summary aria-label={group.label} title={group.label}>
                  <span class="rail-hide">{group.label}</span>
                  <svg class="nav-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </summary>
                <div style="display:flex; flex-direction:column; gap:2px; padding-top:2px;">
                  {group.items.map((item) => <NavLink {...withActive(item)} />)}
                </div>
              </details>
            ) : (
              <div role="group" aria-label={group.label} style="display:flex; flex-direction:column; gap:2px; margin-top:14px;">
                <div
                  class="rail-hide"
                  style="padding:0 10px 4px; font-size:var(--text-2xs); color:var(--text-secondary); font-weight:var(--weight-medium);"
                >
                  {group.label}
                </div>
                {group.items.map((item) => <NavLink {...withActive(item)} />)}
              </div>
            ))
          }
        </nav>
        <div style="margin-top:auto; display:flex; flex-direction:column;">
          <nav aria-label="Settings and help" style="display:flex; flex-direction:column; gap:2px; padding:0 10px 10px;">
            {foot.map((item) => <NavLink {...withActive(item)} />)}
          </nav>
          {
            user && (
              <div class="sidebar-user" title={`${roleLabel(user.role)}: ${roleCan(user.role)}`} style="padding:12px 16px; border-top:1px solid var(--border-hairline); display:flex; align-items:center; gap:10px;">
                {/* One name for the person at every width: the rail hides the text, so the initials carry it. */}
                <div role="img" aria-label={`${displayName}, ${roleLabel(user.role)}`} style="width:30px; height:30px; border-radius:50%; background:var(--accent-wash); color:var(--text-accent); display:flex; align-items:center; justify-content:center; font-family:var(--font-mono); font-size:12px; font-weight:600; flex:none;">
                  {initials}
                </div>
                <div class="rail-hide" aria-hidden="true" style="min-width:0; flex:1;">
                  <div style="font-size:var(--text-sm); color:var(--text-heading); font-weight:var(--weight-medium); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                    {displayName}
                  </div>
                  <div style="font-size:var(--text-2xs); color:var(--text-secondary);">
                    {roleLabel(user.role)}
                  </div>
                </div>
                <a
                  href="/auth/logout"
                  title="Log out"
                  style="display:flex; padding:6px; color:var(--text-secondary); border-radius:var(--radius-sm); text-decoration:none;"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <path d="m16 17 5-5-5-5" />
                    <path d="M21 12H9" />
                  </svg>
                </a>
              </div>
            )
          }
          <HealthBadges client:idle />
        </div>
      </aside>
      <main id="main" tabindex="-1" style="flex:1; min-width:0; display:flex; flex-direction:column; overflow:hidden;">
        <slot />
      </main>
    </div>
  </body>
</html>
