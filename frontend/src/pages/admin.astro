---
import AppLayout from "../layouts/AppLayout.astro";
import AdminIsland from "../components/islands/AdminIsland.jsx";
import AdminOnly from "../components/shell/AdminOnly.astro";

// Admin-only. The API enforces this too (require_admin on /api/admin); anyone
// else gets a page that says why rather than an unexplained bounce.
const isAdmin = Astro.locals.user?.role === "admin";
if (!isAdmin) Astro.response.status = 403;
---

<AppLayout title="AI models">
  {isAdmin ? <AdminIsland client:load /> : <AdminOnly title="AI models" />}
</AppLayout>
